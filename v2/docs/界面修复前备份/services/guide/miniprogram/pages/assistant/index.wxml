<module-shell active="assistant" hide-nav="{{keyboardHeight > 0}}"/>
<view class="page {{messages.length ? 'has-conversation' : ''}} {{motionOff ? 'motion-off' : ''}} assistant-page">
 <view class="hero"><button class="motion-toggle" bindtap="toggleMotion">{{motionOff ? '开启动效' : '暂停动效'}}</button><view class="eyebrow">使用指导 · 地点探索 · 史料问答</view><view class="title">AI导览助手</view><view class="subtitle">了解怎么用、去哪里、怎么安排文化路线</view></view>
 
 <view class="guide-welcome" wx:if="!messages.length"><view class="guide-halo"></view><image class="guide-character" mode="aspectFit" src="/assets/ai-guide-xiaoying-v1.webp"/><view class="guide-copy"><view class="guide-kicker">原创AI导览员</view><view class="heading">你好，我是小迹</view><view class="guide-intro">陪你读懂人物故事，<view>发现身边的历史足迹。</view></view><view class="guide-skills"><text>使用指导</text><text>史料问答</text><text>文化探索</text></view><view class="guide-disclosure">AI生成形象 · 非历史人物</view></view></view>
 <view class="fine evidence-badge">{{label}}</view><view class="hint row"><text>{{preferenceLabel || '告诉我城市、时间和步行偏好'}}</text><button class="ghost" bindtap="resetGuide" disabled="{{busy}}">新导览</button></view>
 <view wx:if="personId || eventId" class="hint row"><text>正在讨论：{{contextName || personId || eventId}}</text><button class="ghost" bindtap="clearContext">取消限定</button></view>
 <view class="scenario-grid"><view class="scenario {{scene === 'help' ? 'active' : ''}}" data-scene="help" bindtap="scenario"><view class="scenario-title">使用指导</view><view class="scenario-note">找到功能入口</view></view><view class="scenario {{scene === 'history' ? 'active' : ''}}" data-scene="history" bindtap="scenario"><view class="scenario-title">史料问答</view><view class="scenario-note">理解人物事件</view></view><view class="scenario {{scene === 'guide' ? 'active' : ''}}" data-scene="guide" bindtap="scenario"><view class="scenario-title">文化探索</view><view class="scenario-note">规划参观草案</view></view></view>
 <picker wx:if="scene === 'history'" range="{{people}}" range-key="name" value="{{personIndex}}" bindchange="choosePerson"><view class="row card"><view><view class="fine">选择人物资料范围</view><view class="heading">{{people[personIndex].name}}</view></view><text>切换 ›</text></view></picker>
 <view wx:if="false" class="chips"><button class="chip {{mode === 'auto' ? 'active' : ''}}" data-mode="auto" bindtap="mode">智能导览</button><button class="chip {{mode === 'help' ? 'active' : ''}}" data-mode="help" bindtap="mode">使用与路线指导</button></view>
 
 <view wx:if="!messages.length" class="chips"><button wx:for="{{quick}}" wx:key="*this" class="chip" data-text="{{item}}" bindtap="quick" disabled="{{busy}}">{{item}}</button></view>
 <view wx:if="scene === 'guide' &amp;&amp; !messages.length" class="card preference-panel"><button class="ghost" bindtap="togglePreferences">{{guideCities[guideCityIndex]}} · {{timeOptions[timeIndex]}} · 调整偏好</button><block wx:if="{{preferencesOpen}}"><view class="chips"><picker range="{{guideCities}}" value="{{guideCityIndex}}" data-key="guideCityIndex" bindchange="preference"><button class="chip">{{guideCities[guideCityIndex]}}⌄</button></picker><picker range="{{timeOptions}}" value="{{timeIndex}}" data-key="timeIndex" bindchange="preference"><button class="chip">{{timeOptions[timeIndex]}}⌄</button></picker><picker range="{{walkingOptions}}" value="{{walkingIndex}}" data-key="walkingIndex" bindchange="preference"><button class="chip">{{walkingOptions[walkingIndex]}}⌄</button></picker></view><button class="ghost" disabled="{{busy}}" bindtap="suggestRoute">请小迹推荐地点</button></block></view>
 <view id="reply-{{index}}" wx:for="{{messages}}" wx:key="index" class="card conversation-card {{item.role === 'user' ? 'user' : ''}}">
  <view class="speaker-line"><view wx:if="item.role === 'assistant'" class="xiaoj-avatar"><image class="avatar-portrait" mode="widthFix" src="/assets/ai-guide-xiaoying-v1.webp"/></view><text>{{item.role === 'user' ? '我的提问' : '小迹'}}</text></view><view selectable="{{true}}" class="message gap" wx:if="!item.presentation">{{item.text}}</view><view wx:else class="answer-content answer-{{item.presentation.kind}}"><view wx:if="item.presentation.kind !== 'chat'" class="answer-title">{{item.presentation.title}}</view><view wx:for="{{item.presentation.paragraphs}}" wx:for-item="paragraph" wx:key="index" selectable="{{true}}" class="answer-paragraph">{{paragraph}}</view></view>
  <view wx:for="{{item.placeCards}}" wx:for-item="suggestion" wx:key="id" class="place-mini"><view class="fine">{{suggestion.city}} · {{suggestion.type}}</view><view class="heading">{{suggestion.name}}</view><view class="muted gap">{{suggestion.summary}}</view><view class="fine gap">{{suggestion.routeReady ? '可导航至场馆附近' : '暂缺可导航地图点位'}}</view><view class="chips"><button class="chip" data-type="place" data-id="{{suggestion.id}}" bindtap="action">查看地点</button><button class="chip" data-type="add" data-id="{{suggestion.id}}" bindtap="action">加入草案</button></view></view>
  <view class="message-tools"><button wx:if="item.role === 'assistant'" class="icon-button" aria-label="复制回答" data-index="{{index}}" bindtap="copy"><view class="chat-icon chat-icon-copy"></view></button><button wx:if="item.role === 'user'" class="icon-button" aria-label="修改提问" disabled="{{busy}}" data-index="{{index}}" bindtap="editQuestion"><view class="chat-icon chat-icon-edit"></view></button></view><view class="reply-status" wx:if="item.notice">{{item.notice}}</view>
  <button wx:if="item.sources.length" class="ghost gap" data-index="{{index}}" bindtap="source">查看 {{item.sources.length}} 条来源</button>
  <button wx:if="item.failed" class="ghost gap" data-index="{{index}}" bindtap="retry">重试这条提问</button>
  <view class="reply-actions"><button wx:for="{{item.actions}}" wx:for-item="action" wx:key="index" class="ghost gap" data-type="{{action.type}}" data-id="{{action.id}}" bindtap="action">{{action.label}}</button></view>
 </view>
 <view wx:if="followUps.length &amp;&amp; !busy" class="card"><view class="fine">继续了解</view><view class="chips"><button wx:for="{{followUps}}" wx:key="*this" class="chip" data-text="{{item}}" bindtap="quick">{{item}}</button></view></view>
 <view wx:if="busy" class="hint loading assistant-thinking"><view class="xiaoj-avatar thinking"><image class="avatar-portrait" mode="widthFix" src="/assets/ai-guide-xiaoying-v1.webp"/></view>{{waitSeconds &lt; 8 ? '小迹正在生成回答…' : '回答仍在生成，请稍候；你也可以停止'}}<button class="ghost gap" bindtap="stop">停止回答</button></view>
 <button wx:if="showLatest" class="ghost" bindtap="latest">查看最新回答 ↓</button><view class="fine">近期会话会随提问发送给模型服务，服务器不持久保存聊天记录。请勿填写私人敏感信息。</view>
</view>
<view class="composer" style="{{keyboardHeight > 0 ? 'bottom:' + keyboardHeight + 'px;' : ''}}"><textarea auto-height adjust-position="{{false}}" class="input" value="{{question}}" bindinput="input" maxlength="500" confirm-type="send" bindconfirm="send" placeholder="想了解什么，或计划去哪里？"/><button wx:if="busy" class="primary send-icon" aria-label="停止回答" bindtap="stop"><view class="chat-icon chat-icon-stop"></view></button><button wx:else class="primary send-icon" aria-label="发送提问" disabled="{{!question}}" bindtap="send"><view class="chat-icon chat-icon-send"></view></button></view>
