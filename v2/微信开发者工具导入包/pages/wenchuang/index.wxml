<view class="{{__globalLarge ? 'global-large' : ''}}"><view class="explicit-return"><button bindtap="__returnPrevious">‹ 返回上一页</button></view>
<view class="wc-page">
  <view wx:if="{{mock}}" class="wc-mock">当前为演示数据（mock={{mock}}），不是真实解锁与领取记录</view>
  <view wx:if="{{loading}}" class="wc-state"><view class="wc-state-title">正在读取文创馆</view><text class="muted">请稍候…</text></view>
  <view wx:elif="{{error}}" class="wc-state">
    <view class="wc-state-title">{{errorTitle}}</view>
    <text class="muted">{{error}}</text>
    <button class="btn btn-primary" bindtap="onErrorAction">{{needLogin ? '去登录 ↗' : '重新读取'}}</button>
  </view>
  <block wx:else>
    <view class="wc-banner">
      <text class="eyebrow">文创馆 / CULTURAL GIFTS</text>
      <text class="page-title">把学过的故事，带走一份纪念</text>
      <text class="muted">完成学习挑战、获得称号，就能解锁对应的数字文创。称号永久保留，领取不会消耗称号。</text>
      <view class="wc-summary">{{summary}}</view>
      <view wx:if="{{!guest && total}}" class="wc-meter"><view class="wc-meter-fill" style="width: {{unlockPercent}}%;"></view></view>
      <button wx:if="{{guest}}" class="btn btn-outline" bindtap="login">登录 ↗</button>
      <button wx:else class="btn btn-outline" bindtap="goCollection">我的收藏 ↗</button>
    </view>
    <view wx:if="{{!total}}" class="wc-state"><view class="wc-state-title">新作品正在整理中</view><text class="muted">文创馆暂时还没有上架作品，稍后再来看看。</text></view>
    <block wx:else>
      <view class="chips">
        <view wx:for="{{cats}}" wx:key="*this" class="chip {{category===item ? 'chip-on' : ''}}" data-cat="{{item}}" bindtap="setCategory">{{item}}</view>
      </view>
      <view wx:if="{{shown.length}}" class="wc-grid">
        <button wx:for="{{shown}}" wx:key="id" class="wc-card {{item.stateKey==='locked' ? 'wc-locked' : ''}}" data-id="{{item.id}}" bindtap="openDetail">
          <view class="wc-art">
            <image wx:if="{{item.cover}}" class="wc-art-img" src="{{item.cover}}" mode="aspectFit"/>
            <view wx:else class="wc-ph ph-{{item.kind}}"></view>
            <view wx:if="{{!item.cover}}" class="ph-note">示意占位 · 正式图稿待上架</view>
          </view>
          <view class="wc-card-body">
            <view class="wc-card-top"><text class="tag">{{item.category}}</text><text class="wc-badge badge-{{item.stateKey}}">{{item.stateLabel}}</text></view>
            <text class="wc-card-name">{{item.name}}</text>
            <text class="small">{{item.tagline}}</text>
            <view wx:if="{{item.required && !item.guest}}" class="wc-meter"><view class="wc-meter-fill" style="width: {{item.percent}}%;"></view></view>
            <text class="small">{{item.progressLabel}}</text>
          </view>
        </button>
      </view>
      <view wx:else class="wc-state"><view class="wc-state-title">这一类暂时没有作品</view><text class="muted">换一个分类看看。</text></view>
    </block>
    <view class="wc-note">文创为原创艺术化设计，称号只记录学习进度，不代表史料已核验，也不是证书或官方勋章。</view>
  </block>
</view>
</view>