<view class="{{__globalLarge ? 'global-large' : ''}}"><view class="explicit-return"><button bindtap="__returnPrevious">‹ 返回上一页</button></view>
<view class="page learning-page"><view wx:if="{{top}}" class="reward-scene {{stopped?'motion-stopped':''}}"><button class="reward-skip" bindtap="skip">跳过动画</button><view class="eyebrow">山河有迹 · 学习印记</view><view class="reward-badge-halo"><image class="reward-main-badge" src="{{top.badge}}" mode="aspectFit"/></view><view class="reward-new">新称号已获得</view><view class="reward-title">{{top.name}}</view><view class="reward-condition">{{top.condition}}</view><view class="aux">这一段学习，留下了新的印记。</view><view wx:if="{{items.length>1}}" class="reward-additional"><view>本次共获得 {{items.length}} 枚</view><view class="reward-extra-row"><view wx:for="{{items}}" wx:key="id"><image src="{{item.badge}}" mode="aspectFit"/><view>{{item.name}}</view></view></view></view><view class="reward-actions"><button class="primary" bindtap="continueLearning">继续学习</button><button class="secondary" bindtap="album">查看徽章册</button><button class="secondary" bindtap="wenchuang">去文创馆领取 ↗</button></view><button class="reward-result-link" bindtap="result">查看作答结果 ↗</button><view class="fine">称号记录学习进度，不代表史料核验结论。</view></view><view wx:else class="state"><view>本次没有新的称号</view><button bindtap="result">返回作答结果</button></view></view></view>