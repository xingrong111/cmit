<view class="{{__globalLarge ? 'global-large' : ''}}"><view class="explicit-return"><button bindtap="__returnPrevious">‹ 返回上一页</button></view>
<view class="page"><view class="hero"><text class="eyebrow">我的 / COMMENT STATUS</text><text class="title">评论状态</text><text class="muted">待审核、已公开和退回修改都会显示明确说明。</text></view><view wx:if="{{!user}}" class="card"><text class="section-title">登录后查看</text><button class="primary full" bindtap="login">去登录</button></view><view wx:else class="card"><view wx:if="{{!items.length}}" class="empty"><text class="section-title">还没有评论</text><text>从人物、事件或学习回顾页进入讨论。</text></view><view wx:for="{{items}}" wx:key="id" class="item"><view class="item-head"><text>{{item.topicTitle}}</text><text class="status {{item.status}}">{{item.statusText}}</text></view><text wx:if="{{editingId!==item.id}}" class="comment">{{item.content}}</text><label wx:else class="field">修改评论<textarea value="{{editingContent}}" bindinput="editInput" maxlength="500" /></label><text class="small">提交：{{item.submittedAt}} · 版本 {{item.version}}</text><view wx:if="{{item.reviewReason}}" class="notice error">退回原因：{{item.reviewReason}}</view><view wx:if="{{editingId===item.id}}" class="row"><button class="secondary" bindtap="cancelEdit">取消</button><button class="primary" bindtap="saveEdit">重新提交</button></view><button wx:elif="{{item.editable}}" class="secondary full" data-id="{{item.id}}" data-version="{{item.version}}" data-content="{{item.content}}" bindtap="edit">修改并重新提交</button></view></view></view>
</view>