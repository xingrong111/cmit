<view class="{{__globalLarge ? 'global-large' : ''}}"><view class="explicit-return"><button bindtap="__returnPrevious">‹ 返回上一页</button></view>
<view class="page learning-page">
  <view wx:if="{{loading}}" class="aux">正在读取题目。</view>
  <view wx:elif="{{error}}" class="state">
    <view class="section">请求失败</view>
    <view class="aux">{{error}}</view>
    <button class="primary" bindtap="load">重新读取</button>
  </view>
  <block wx:elif="{{question}}">
    <view class="eyebrow">待核验</view>
    <view class="title">第 {{question.index + 1}} 题，共 {{attempt.total}} 题</view>
    <view class="aux">{{attempt.person_name}} · {{attempt.difficulty}} · 待核验。提交后才显示答案和来源。</view>
    <view class="card">
      <view class="tag">{{question.type}}</view>
      <view>{{question.stem}}</view>
      <view wx:for="{{question.options}}" wx:key="key" class="choice {{picked === item.key && !feedback ? 'picked' : ''}} {{feedback && item.key === feedback.correct_answer ? 'right' : ''}} {{feedback && item.key === feedback.choice && !feedback.correct ? 'wrong' : ''}}" data-key="{{item.key}}" bindtap="pick">{{item.label}}{{feedback && item.key === feedback.correct_answer ? ' · 正确答案' : ''}}{{feedback && item.key === feedback.choice && item.key !== feedback.correct_answer ? ' · 你的选择' : ''}}</view>
      <view wx:if="{{feedback}}" class="feedback {{feedback.correct ? 'ok' : 'bad'}}">
        <view>{{feedback.correct ? '回答正确' : '回答不正确'}}</view>
        <view>正确答案是 {{feedback.correct_answer}}。{{feedback.explanation}}</view>
        <view class="aux">来源 {{feedback.source_id}} · {{feedback.evidence}} · 待核验</view>
        <button wx:if="{{attempt.person_name === '瞿秋白' || attempt.person_name === '宋振中' || attempt.person_name === '陆定一'}}" class="secondary" bindtap="readArchive">回顾人物史料</button><button wx:if="{{feedback.source_url}}" class="secondary" data-url="{{feedback.source_url}}" bindtap="copySource">查看来源</button>
      </view>
      <button class="primary" disabled="{{busy || (!feedback && !picked)}}" bindtap="act">{{feedback ? (attempt.finished ? '查看结果' : '下一题') : (busy ? '提交中' : '提交这题')}}</button>
    </view>
  </block>
</view>

</view>