/* 最后加载，覆盖各成员原先不同的配色与组件尺度。 */
page{--paper:#FBF5E9;--card:#FFFAF1;--red:#982B28;--green:#354D43;--gold:#BD9A67;--line:#DDD0B8;--ink:#35281D;--muted:#75604B;background:#FBF5E9;color:#35281D;font-family:'PingFang SC','Microsoft YaHei',sans-serif;font-size:28rpx;line-height:1.8}
.primary,.secondary,.outline,.ghost,.danger{min-height:88rpx;border-radius:16rpx;font-size:28rpx;font-weight:500;line-height:1.6}.primary{background:#982B28;color:#FFFAF1;border-color:#982B28}.secondary,.outline,.ghost{background:#FFFAF1;color:#982B28;border:1rpx solid #BD9A67}
.learning-page .stage-card{border-top:6rpx solid #BD9A67;padding:36rpx 32rpx}.learning-page .stage-card .section{font:42rpx/1.6 'SimSun',serif;color:#354D43}.learning-page .stage-card .aux{margin:16rpx 0 24rpx}.learning-topic{padding:28rpx;border-left:6rpx solid #BD9A67;background:#F1E7D5;border-radius:16rpx;margin:24rpx 0;color:#75604B;font-size:26rpx;line-height:1.8}.learning-page .choice{font-size:30rpx;line-height:1.8}.page .menu button{min-height:100rpx;padding:24rpx 8rpx}.assistant-page.has-conversation .hero{padding:20rpx 24rpx;margin-bottom:18rpx}.assistant-page.has-conversation .hero .subtitle{display:none}.assistant-page .guide-copy .heading{font-size:42rpx;white-space:nowrap}.assistant-page .guide-skills{gap:10rpx}.assistant-page .guide-disclosure{font-size:22rpx}.assistant-page .answer-paragraph{font-size:30rpx;line-height:1.9}.reply-actions{gap:12rpx}.composer .send-icon{min-height:80rpx}.learning-page .row{gap:20rpx}
.card,.fact-card,.source-card,.person-card,.timeline-card,.preference-card,.stage-card,.honor-card,.q-bank{border-radius:24rpx;border-color:#DDD0B8;background:#FFFAF1;box-shadow:0 6rpx 24rpx #35281d05}.hero{border-radius:24rpx;border-color:#DDD0B8;background:linear-gradient(120deg,#F1E7D5,#FBF5E9)}.title,.section-title,.heading,.page-title{font-family:'STSong','SimSun',serif;font-weight:500;color:#354D43}.eyebrow,.muted,.small,.aux,.meta{color:#75604B}.field input,.field textarea,.input{background:#FFFAF1;border-color:#DDD0B8;border-radius:16rpx}.chip,.tab{border-radius:16rpx}.chip.active,.tab.active{background:#354D43;border-color:#354D43;color:#FFFAF1}.notice,.hint{background:#F1E7D5;border-radius:16rpx}.message{border-color:#DDD0B8}.composer{background:#FBF5E9}.primary[disabled],.secondary[disabled]{opacity:.5}
.learning-page .primary,.learning-page .secondary{display:inline-flex;align-items:center;justify-content:center;text-align:center;width:auto;min-width:160rpx;max-width:440rpx;min-height:80rpx;padding:16rpx 28rpx;margin-left:0;margin-right:16rpx;line-height:1.5;font-size:27rpx;white-space:normal}.learning-page .person-actions{display:flex;flex-wrap:wrap;gap:16rpx}.learning-page .person-actions button{margin:0;flex:none}.learning-page .person-card{border:1rpx solid #e4d2b8;border-radius:28rpx;background:#fff9ef;padding:32rpx}.learning-page .learning-path{display:flex;gap:10rpx;margin:32rpx 0}.learning-page .learning-path text{flex:1;min-width:0;padding:18rpx 6rpx;font-size:23rpx;text-align:center;background:#f2e7d6;border-bottom:3rpx solid #bd9a67;border-radius:12rpx 12rpx 0 0}.learning-page .stage-card{border-left:5rpx solid #982b28;padding:34rpx}.learning-page .stage-card button{margin-top:24rpx}.learning-page button[disabled]{background:#e8e1d7;color:#807365}.learning-page .choice{border-radius:18rpx;padding:26rpx;line-height:1.8}.learning-page .title{line-height:1.5}.learning-page .feedback{border-radius:20rpx;padding:28rpx}.learning-page .progress-split{gap:24rpx}.learning-page .learning-topic{line-height:1.9;border-left:5rpx solid #982b28;padding:26rpx;background:#f4ebdb}
.scene-icon{width:76rpx;height:76rpx;display:block;margin:0 auto 10rpx}.module-title-row{display:flex;align-items:center;gap:18rpx}.module-feature-icon{width:76rpx;height:76rpx;flex-shrink:0}.account-title-icon{width:96rpx;height:96rpx;margin-bottom:18rpx}.learning-page .learning-title-icon{width:100rpx;height:100rpx;display:block;margin-bottom:18rpx}.learning-page .learning-person-icon{width:100rpx;height:100rpx;flex-shrink:0}.has-conversation .scene-icon{width:48rpx;height:48rpx}

.global-large{font-size:36rpx}.global-large .message,.global-large .reading-body,.global-large .answer-paragraph,.global-large .choice,.global-large .row-title,.global-large .aux,.global-large .muted,.global-large .name-origin{font-size:36rpx!important;line-height:1.9!important}.global-large .fine,.global-large .small,.global-large .eyebrow,.global-large .step-note,.global-large .pill,.global-large .tag,.global-large .boundary-note{font-size:29rpx!important;line-height:1.85!important}.global-large button{font-size:32rpx!important;line-height:1.7!important;white-space:normal}.global-large .title,.global-large .page-title,.global-large .hero-title,.global-large .learning-cover-title{font-size:58rpx!important;line-height:1.65!important}.global-large .section,.global-large .heading,.global-large .section-title,.global-large .block-title{font-size:46rpx!important;line-height:1.65!important}.global-large .person-actions{flex-wrap:wrap}.global-large .learning-two-steps{flex-wrap:wrap}.global-large .learning-step{font-size:31rpx;line-height:1.8}.global-large .preference-sample{font-size:42rpx!important}

.global-large .reward-title{font-size:66rpx!important}
