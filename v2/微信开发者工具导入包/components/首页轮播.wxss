.story-carousel{border:1px solid #e4d3b6;border-radius:18px;overflow:hidden;background:#fbf5e9;margin-top:20px;box-shadow:0 10px 28px rgba(98,67,34,.03)}.story-swiper{height:420px}.story-slide{position:relative;height:100%;overflow:hidden}.slide-landscape{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%}.slide-copy{position:relative;padding:42px 44px;width:57%;z-index:2}.slide-copy .eyebrow{font-size:10px;letter-spacing:.16em;color:#92744f}.slide-title{display:block;font-family:STSong,SimSun,serif;font-size:43px;line-height:1.5;letter-spacing:.08em;color:#354d43;margin:18px 0}.slide-description{display:block;font-size:13px;line-height:1.95;color:#7e6d57;max-width:350px}.slide-action{display:flex;justify-content:space-between;width:150px;min-height:44px;padding:10px 16px;font-size:13px;margin:22px 0 0}.slide-note{display:block;font-size:10px;color:#9c8768;margin-top:17px}.slide-seal{position:absolute;right:28px;top:32px;writing-mode:vertical-rl;border:1px solid #aa645660;padding:12px 6px;color:#982b28;font-family:STSong,SimSun,serif;letter-spacing:.2em;font-size:14px}.slide-portrait{position:absolute;right:8%;bottom:0;width:36%;height:85%;z-index:1}.slide-1 .slide-landscape,.slide-2 .slide-landscape{opacity:.45}.slide-navigation{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #e6d7bf;background:#fffaf1;padding:10px 20px;gap:12px}.slide-tabs{display:flex;gap:10px}.slide-tabs button{display:flex;gap:7px;align-items:center;justify-content:center;padding:8px 13px;font-size:12px;color:#8a775f;min-height:40px;border-radius:8px}.slide-tabs button text{font-family:Georgia,serif;font-size:10px;opacity:.7}.slide-tabs button.selected{background:#f0e4d1;color:#982b28}.slide-arrows{display:flex;align-items:center;gap:12px;color:#8a775f}.slide-arrows>text{font-size:10px;white-space:nowrap}.slide-arrows button{width:38px;min-height:38px;border:1px solid #e4d3b6;border-radius:50%;font-size:23px;line-height:1;color:#982b28}@media (max-width:650px){.story-swiper{height:430px}.slide-copy{padding:27px 22px;width:100%}.slide-title{font-size:29px;margin:16px 0}.slide-description{font-size:12px;max-width:75%}.slide-note{font-size:9px;max-width:70%;line-height:1.7}.slide-action{width:135px;font-size:12px;margin-top:18px}.slide-portrait{right:-5%;width:52%;height:45%;opacity:.9}.slide-1 .slide-copy,.slide-2 .slide-copy{padding-bottom:130px}.slide-seal{right:13px;top:25px;font-size:11px;padding:8px 4px}.slide-navigation{padding:8px;gap:3px}.slide-tabs{gap:2px}.slide-tabs button{font-size:10px;padding:7px 8px;gap:4px}.slide-arrows{gap:5px}.slide-arrows button{width:30px;min-height:34px}.slide-arrows>text{display:none}}