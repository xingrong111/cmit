<view wx:if="{{a}}" class="onboard-card" role="region" aria-label="新手上手三步"><view class="onboard-head"><view class="onboard-title"><text class="onboard-eyebrow">{{b}}</text><text class="onboard-sub">{{c}}</text></view><view class="onboard-progress" aria-label="{{f}}"><view class="onboard-bar"><view style="{{'width:' + d}}"/></view><text>{{e}} / 3</text></view><view class="onboard-actions"><button class="onboard-link" bindtap="{{g}}">使用指南 ↗</button><button class="onboard-close" aria-label="关闭上手提示" bindtap="{{i}}">{{h}}</button></view></view><view wx:if="{{j}}" class="onboard-steps"><view wx:for="{{k}}" wx:for-item="s" wx:key="f" class="{{['onboard-step', s.g && 'done', s.h && 'next']}}"><text class="onboard-no">{{s.a}}</text><view class="onboard-copy"><text class="onboard-step-title">{{s.b}}</text></view><button class="{{['onboard-go', s.d && 'primary']}}" bindtap="{{s.e}}">{{s.c}}</button></view></view><view wx:else class="onboard-next"><button bindtap="{{l}}">试一次学习挑战</button><button bindtap="{{m}}">看看历史足迹</button></view></view>