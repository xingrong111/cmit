.xiaoji-root{position:fixed;z-index:70;pointer-events:none;transition:transform .22s ease}.xiaoji-root>*{pointer-events:auto}.xiaoji-ball-wrap{position:relative;width:60px;height:60px}.xiaoji-copy{position:absolute;right:68px;top:14px;max-width:126px;padding:6px 10px;background:rgba(255,250,241,.933);border:1px solid #e2d3b8;border-radius:10px 10px 4px;font-size:12px;line-height:1.5;color:#534433;white-space:nowrap}.xiaoji-root.left .xiaoji-copy{right:auto;left:68px;border-radius:10px 10px 10px 4px}.xiaoji-ball{width:60px;height:60px;min-height:60px;margin:0;padding:0;border-radius:50%;border:2px solid #d7c09a;background:#f4ead6;box-shadow:0 6px 16px rgba(75,53,24,.133);overflow:hidden;cursor:grab;-moz-user-select:none;user-select:none;-webkit-user-select:none;touch-action:none}.xiaoji-ball:after{border:0}.xiaoji-face{width:100%;height:100%;display:block;pointer-events:none}.xiaoji-face div{background-size:165% auto!important;background-position:65% 5%!important}.xiaoji-mini div{background-size:220% auto!important;background-position:50% 0!important}.xiaoji-mini{width:34px;height:34px;border-radius:50%;border:1px solid #e2d3b8;background:#f3e7d2;flex-shrink:0;display:block;overflow:hidden}.xiaoji-root.docked:not(.left){transform:translate(38px)}.xiaoji-root.docked.left{transform:translate(-38px)}.xiaoji-window{display:flex;flex-direction:column;min-height:0;background:rgba(255,250,242,.91);border:1px solid #e2d4bb;border-radius:16px;box-shadow:0 18px 48px rgba(60,42,20,.06);backdrop-filter:blur(16px);overflow:hidden}.xiaoji-bar{display:flex;align-items:center;gap:8px;padding:8px 10px;border-bottom:1px solid #eadfcd;cursor:move;flex:none}.xiaoji-mini{width:36px;height:44px;border-radius:0;border:0;background:transparent;flex-shrink:0}.xiaoji-bar-copy{flex:1;min-width:0}.xiaoji-name{display:block;font:14px/1.4 STSong,SimSun,serif;color:#354d43}.xiaoji-sub{display:block;font-size:12px;color:#534433}.xiaoji-disclaimer{display:block;padding:0 12px 8px;font-size:12px;line-height:1.5;color:#534433;text-align:center;background:rgba(255,250,242,.91)}.xiaoji-full,.xiaoji-min{margin:0;padding:4px 10px;min-height:32px;font-size:12px;border-radius:8px;background:#f4edde;color:#534433}.xiaoji-min{background:#982b28;color:#fffaf1;font-weight:600}.xiaoji-full:after,.xiaoji-min:after{border:0}.xiaoji-thread{flex:1;min-height:0;height:0;padding:8px 12px}.xiaoji-empty{padding:18px 6px;color:#534433;font-size:12px;line-height:1.8}.xiaoji-starts{display:flex;flex-direction:column;gap:6px;margin-top:12px}.xiaoji-starts button{margin:0;text-align:left;padding:8px 10px;min-height:34px;font-size:12px;border:1px solid #e2d3b8;border-radius:9px;background:#fffdf8;color:#6d5b45}.xiaoji-starts button:after{border:0}.xiaoji-turn{margin:8px 0;display:flex;flex-direction:column;gap:4px}.xiaoji-turn.user{align-items:flex-end}.xiaoji-bubble{max-width:88%;padding:8px 11px;border-radius:12px;font-size:14px;line-height:1.7;background:#fffaf1;border:1px solid #eadbc4;color:#35281d}.xiaoji-turn.user .xiaoji-bubble{background:#f1e7d5;border-color:#e4d3b5;border-radius:12px 12px 4px}.xiaoji-notice,.xiaoji-cites,.xiaoji-wait,.xiaoji-error{font-size:12px;line-height:1.6;color:#534433}.xiaoji-cites{display:flex;flex-direction:column;gap:2px;padding:4px 0}.xiaoji-error{color:#8a3b32;background:#f9e8e3;border-radius:8px;padding:7px 9px}.xiaoji-composer{display:flex;align-items:flex-end;gap:8px;margin:6px 10px;padding:6px 6px 6px 12px;border:1px solid #e4d3b5;border-radius:14px;background:#fffdf8;flex:none}.xiaoji-composer:focus-within{border-color:#982b28;box-shadow:0 4px 14px rgba(152,43,40,.08)}.xiaoji-input{flex:1;min-width:0;min-height:34px;max-height:84px;padding:6px 0;font-size:14px;line-height:1.6;background:transparent}.xiaoji-send{display:flex;align-items:center;justify-content:center;width:36px;height:36px;min-height:36px;margin:0;padding:0;border-radius:50%;background:#982b28;flex-shrink:0}.xiaoji-send-icon{width:20px;height:20px;display:block;pointer-events:none}.xiaoji-send:after{border:0}.xiaoji-send[disabled]{opacity:.4}.xiaoji-resize{position:absolute;right:2px;bottom:2px;width:16px;height:16px;cursor:nwse-resize;background:linear-gradient(135deg,transparent 50%,#bd9a67 50%)}@media (max-width:650px){.xiaoji-copy,.xiaoji-full{display:none}}@media (prefers-reduced-motion:reduce){.xiaoji-root{transition:none}}