.reward-scene{position:relative;padding:70rpx 30rpx 45rpx;border:1rpx solid #ddc8a4;border-radius:32rpx;text-align:center;background:radial-gradient(ellipse at 50% 30%,#f2dfb5,#fcf6ea 65%)}.reward-scene>.eyebrow{font-size:21rpx;color:#a48656;letter-spacing:2rpx}.reward-skip{position:absolute;right:22rpx;top:20rpx;font-size:20rpx!important;padding:9rpx 17rpx;min-height:45rpx!important;background:#f3e9d5;border-radius:25rpx;color:#9c8056}.reward-badge-halo{position:relative;width:440rpx;height:430rpx;margin:10rpx auto 0;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle,#e7ca9044,transparent 70%)}.reward-main-badge{width:380rpx;height:380rpx;animation:reward-arrive .85s ease-out both}.reward-new{display:inline-block;background:#efdfc2;color:#982b28;border-radius:24rpx;font-size:22rpx;padding:8rpx 21rpx}.reward-title{font:57rpx/1.7 STSong,SimSun,serif;color:#354d43;margin:20rpx 0 9rpx}.reward-condition{font-size:28rpx;color:#8a714b;line-height:1.9}.reward-scene>.aux{font-size:23rpx;color:#ad9270;margin:15rpx 0}.reward-additional{border-top:1rpx solid #e7d6b6;padding-top:25rpx;margin-top:30rpx;font-size:22rpx;color:#9d8259}.reward-extra-row{display:flex;justify-content:center;gap:18rpx;flex-wrap:wrap;margin-top:16rpx}.reward-extra-row>view{width:145rpx;font-size:20rpx}.reward-extra-row image{display:block;width:88rpx;height:88rpx;margin:0 auto 8rpx}.reward-actions{display:flex;gap:16rpx;margin:35rpx 0 16rpx}.reward-actions button{flex:1;min-width:0;min-height:80rpx;font-size:26rpx;line-height:1.7;padding:16rpx 10rpx;border-radius:17rpx}.reward-result-link{font-size:23rpx;color:#94784e;background:transparent;min-height:62rpx}.reward-result-link::after{border:0}.reward-scene>.fine{font-size:20rpx;color:#ad9776;line-height:1.9;margin-top:20rpx}.motion-stopped .reward-main-badge{animation:none}@keyframes reward-arrive{from{opacity:0;transform:translateY(-18rpx) scale(.75)}to{opacity:1;transform:scale(1)}}
