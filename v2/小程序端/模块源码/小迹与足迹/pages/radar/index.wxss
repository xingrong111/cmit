.native-ink-map{border:1rpx solid #bd9a6780;border-radius:12rpx;overflow:hidden;background:#fffaf1;margin-top:22rpx}.native-map-heading{padding:24rpx 28rpx;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(110deg,#fffaf1,#f1e7d5);border-bottom:1rpx solid #ddd0b8}.native-map-heading .fine{font-size:18rpx;letter-spacing:2rpx}.native-map-heading .heading{color:#354d43;font-family:SimSun,serif;font-size:34rpx;margin-top:8rpx}.native-map-seal{border:1rpx solid #982b2866;color:#982b28;font:38rpx SimSun,serif;padding:6rpx 10rpx}.native-ink-map .map{margin:0;border:0;border-radius:0;width:100%;height:550rpx}.native-map-caption{font-size:20rpx;line-height:1.8;color:#75604b;padding:20rpx 26rpx;border-top:1rpx solid #ddd0b8}
