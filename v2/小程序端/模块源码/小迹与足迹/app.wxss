.assistant-page{display:flex;flex-direction:column}.conversation-card.user{align-self:flex-end;max-width:84%;width:auto;margin:16rpx 0;padding:18rpx 24rpx;box-sizing:border-box;border-radius:28rpx 28rpx 6rpx 28rpx}.conversation-card.user .gap{margin-top:0}.conversation-card.user .message{font-size:27rpx;line-height:1.65}.conversation-card.user .message-tools{justify-content:flex-end;margin-top:4rpx}.conversation-card.user .icon-button{height:56rpx;min-height:56rpx;width:66rpx}.reply-status{font-size:21rpx;line-height:1.5;color:#877763;margin-top:16rpx}.reply-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}.reply-actions .ghost{font-size:24rpx;line-height:1.4;padding:14rpx 20rpx;min-height:64rpx;margin:0;border-radius:32rpx;max-width:100%}.place-mini{padding:24rpx;margin-top:20rpx}.place-mini .chips button{font-size:23rpx;padding:12rpx 18rpx;margin:0;line-height:1.5}.place-mini .heading{font-size:29rpx}

.theme-map-card{border:1rpx solid #cbb38a;background:#fffaf1;border-radius:26rpx;overflow:hidden;margin:22rpx 0;box-shadow:0 12rpx 32rpx #35281d09}.map-heading{display:flex;justify-content:space-between;align-items:center;padding:20rpx 24rpx;font:31rpx KaiTi,serif;color:#982b28}.map-kind{font:20rpx sans-serif;color:#806a52;border:1rpx solid #cbb38a;border-radius:22rpx;padding:5rpx 12rpx}.theme-map-viewport{height:440rpx;position:relative;overflow:hidden}.theme-map-layer{position:absolute;inset:0;transform-origin:center;transition:transform .25s}.theme-map-art{width:100%;height:100%;display:block}.map-pin{position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;flex-direction:column;gap:6rpx;width:230rpx}.pin-number{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;border-radius:50% 50% 50% 8rpx;transform:rotate(-10deg);color:#fffaf1;background:#982b28;border:3rpx solid #fffaf1;box-shadow:0 4rpx 12rpx #982b2833;font:25rpx Georgia,serif}.pin-name{background:#fffaf1ef;border:1rpx solid #bd9a6755;padding:6rpx 10rpx;border-radius:12rpx;max-width:230rpx;font-size:20rpx;line-height:1.4;color:#53432f}.map-pin.selected .pin-number{box-shadow:0 0 0 8rpx #982b2820}.map-tools{position:absolute;right:16rpx;bottom:18rpx;display:flex;flex-direction:column;gap:8rpx}.map-tools button{padding:0;width:66rpx;height:66rpx;min-height:66rpx;line-height:66rpx;background:#fffaf1e8;border:1rpx solid #cbb38a;border-radius:12rpx;color:#806a52;font-size:24rpx;margin:0}.map-tools button::after{border:0}.map-watermark{position:absolute;left:20rpx;bottom:20rpx;color:#806a52;font:23rpx KaiTi,serif;letter-spacing:3rpx}.theme-map-card .map-caption{padding:16rpx 20rpx;color:#806a52;font-size:20rpx;line-height:1.6;background:#fffaf1;border-top:1rpx solid #cbb38a55}

/* 英迹统一视觉基础 */
:root,page,.app-shell{--paper:#FBF5E9;--card:#FFFAF1;--ink:#35281D;--red:#982B28;--red-dark:#762321;--green:#354D43;--gold:#BD9A67;--muted:#75604B;--line:#DDD0B8;--wash:#F1E7D5;--radius:12px;--serif:"Noto Serif SC","STSong","SimSun",serif;--sans:"PingFang SC","Microsoft YaHei",sans-serif}
.primary,.secondary,.outline,.danger{border-radius:8px;min-height:44px;transition:background .18s,transform .18s,opacity .18s}
.card,.fact-card,.source-card,.preference-card,.hero,.person-card,.q-bank{border-radius:12px}
button:focus-visible,a:focus-visible{outline:2px solid var(--red);outline-offset:3px}
button:disabled{cursor:default;opacity:.5}
.title,.section-title,.page-title{font-family:var(--serif)}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

