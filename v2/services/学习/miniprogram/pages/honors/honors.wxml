<view class="page learning-page"><view wx:if="{{loading}}" class="aux">正在展开徽章册…</view><view wx:elif="{{error}}" class="state"><view>{{error}}</view><button bindtap="load">重新读取</button></view><block wx:else><view class="eyebrow">山河有迹 · 我的学习印记</view><view class="title">学习徽章册</view><view class="card badge-album-cover"><view><view class="aux">当前称号</view><view class="section">{{earnedCount ? current : '从第一枚星火开始'}}</view><view class="aux">已获得 {{earnedCount}} / {{totalCount}} 枚徽章</view><view class="aux">完整学习 {{completed}} / 5 组</view></view><image class="album-current-badge {{earnedCount?'':'unearned'}}" src="{{currentBadge}}" mode="aspectFit"/></view><view class="aux next-goal">下一目标：{{nextGoal}}</view><view class="badge-album-grid"><view class="badge-album-card {{item.earned?'earned':item.next?'next':'locked'}}" wx:for="{{pathItems}}" wx:key="key"><view class="eyebrow">{{item.index}} / 成长印记</view><image src="{{item.badge}}" mode="aspectFit"/><view class="section">{{item.name}}</view><view class="badge-state">{{item.earned?'已获得':item.next?'下一目标':'未解锁'}}</view><view class="aux">{{item.detail}}</view><view class="aux">{{item.progress}}</view></view></view><view class="aux honor-rule-note">{{note}}</view><button class="primary" bindtap="hall">继续学习</button></block></view>