.progress-split { display: flex; margin-top: 16rpx; }
.progress-split > view { flex: 1; }
.progress-split > view + view { border-left: 1rpx solid #E4D4B8; padding-left: 16rpx; }
.honor-stat { font-family: "STKaiti", "KaiTi", "SimSun", serif; font-size: 32rpx; line-height: 1.35; }
.meter { height: 8rpx; margin-top: 8rpx; background: #E4D4B8; border-radius: 8rpx; overflow: hidden; }
.meter view { height: 8rpx; background: #9C3029; }
.filters { display: flex; gap: 16rpx; margin-top: 8rpx; }
.seg { flex: 1; min-height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 40rpx; border: 1rpx solid #E4D4B8; background: #FFFCF5; color: #35291F; font-size: 28rpx; }
.seg.on { background: #9C3029; color: #FFF9EC; border-color: #9C3029; }
.section-head { min-height: 88rpx; margin-top: 24rpx; padding: 16rpx 0; font-family: "STKaiti", "KaiTi", "SimSun", serif; font-size: 32rpx; }
.person-card { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; }
.person-main { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 280rpx; }
.mark { width: 72rpx; height: 72rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 1rpx solid #C7A166; border-radius: 50%; background: #FFF9EC; color: #9C3029; font-family: "STKaiti", "KaiTi", "SimSun", serif; font-size: 32rpx; }
.copy { flex: 1; min-width: 0; }
.pill { flex: none; border: 1rpx solid #C7A166; border-radius: 40rpx; color: #75634D; font-size: 24rpx; line-height: 1.6; padding: 4rpx 16rpx; }
.pill.earned { color: #2F724F; border-color: #2F724F; }
.person-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8rpx; margin-left: auto; }
.person-actions .primary, .person-actions .secondary { width: auto; min-width: 168rpx; margin-top: 0; min-height: 72rpx; line-height: 72rpx; padding: 0 20rpx; font-size: 24rpx; }
.learning-cover{position:relative;padding:42rpx;border:1rpx solid #deceb0;border-radius:30rpx;background:linear-gradient(115deg,#eee5d2,#faf3e6);margin-bottom:28rpx}.learning-cover .eyebrow{font-size:21rpx;color:#9d8057;letter-spacing:2rpx}.learning-cover-title{font:44rpx/1.6 STSong,SimSun,serif;color:#354d43;margin:18rpx 0}.learning-cover-note{font-size:23rpx;color:#9b815b}.learning-page .person-card{display:flex;align-items:stretch;flex-direction:column;padding:36rpx;border:1rpx solid #e1d2b9;border-radius:28rpx;background:#fffaf2;box-shadow:0 8rpx 26rpx #59462b07;margin-bottom:24rpx;gap:22rpx}.learning-page .person-main{min-width:0;gap:24rpx}.learning-page .person-main .section{font:39rpx/1.5 STSong,SimSun,serif;color:#354d43}.learning-page .person-main .aux{font-size:23rpx;line-height:1.8}.learning-page .learning-person-icon{width:86rpx;height:86rpx;padding:10rpx;background:#f2e8d4;border-radius:22rpx;flex-shrink:0}.learning-page .person-card>.pill{align-self:flex-start;background:#f3ebdc;border:0;border-radius:10rpx;font-size:22rpx;padding:7rpx 16rpx}.learning-page .person-actions{display:flex;flex-wrap:wrap;gap:14rpx;border-top:1rpx solid #eadfc9;padding-top:24rpx}.learning-page .person-actions button{flex:1;min-width:180rpx;margin:0;font-size:25rpx;line-height:1.6;padding:17rpx 22rpx;min-height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx}.learning-page .filters{padding:8rpx;border-radius:18rpx;background:#eee5d4;gap:8rpx}.learning-page .filters .seg{border:0;background:transparent;border-radius:13rpx;font-size:25rpx;min-height:66rpx;line-height:66rpx}.learning-page .filters .seg.on{background:#354d43;color:#fffaf1}.learning-page .card{border-radius:28rpx;border-color:#e1d2b9}.learning-page .learning-topic{font-size:24rpx;line-height:1.9;background:#f3ecdd;border-left:4rpx solid #bda071;padding:24rpx;border-radius:0 14rpx 14rpx 0}
.learning-page .person-card{padding:0!important;gap:0!important;overflow:hidden;min-height:0!important}.learning-person-cover{display:flex;align-items:center;gap:30rpx;padding:32rpx 35rpx 20rpx;background:linear-gradient(110deg,#f0e8d6,#fffaf2);min-height:230rpx;box-sizing:border-box}.learning-portrait-wrap{position:relative;flex:0 0 155rpx;height:183rpx;border:1rpx solid #d9c7a7;border-radius:14rpx;overflow:hidden;background:#e7decb}.learning-card-portrait{width:100%;height:100%;display:block}.learning-image-kind{position:absolute;left:0;right:0;bottom:0;text-align:center;background:#fff9eeeb;padding:5rpx;font-size:17rpx;color:#8d7554}.learning-person-cover .eyebrow{font-size:19rpx;color:#a28658}.learning-person-cover .section{font:43rpx/1.5 STSong,SimSun,serif;color:#354d43;margin:10rpx 0}.learning-person-cover .aux{font-size:21rpx}.learning-page .learning-photo-source{margin:0 35rpx;padding:0 0 16rpx;font-size:19rpx;line-height:1.7;color:#a08863;background:transparent;text-align:left;min-height:0}.learning-photo-source::after{border:0}.learning-two-steps{padding:26rpx 35rpx;display:flex;align-items:center;gap:14rpx;border-top:1rpx solid #eee2ce}.learning-step{display:flex;align-items:center;gap:12rpx;flex:1;min-width:0;font-size:23rpx;color:#75654b}.step-dot{width:43rpx;height:43rpx;flex:0 0 43rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#f0e7d4;border:1rpx solid #ddc9a5;font-size:23rpx;color:#a08459}.is-current .step-dot{background:#982b28;color:#fffaf1;border-color:#982b28}.is-done .step-dot{background:#354d43;color:#fffaf1;border-color:#354d43}.is-locked{opacity:.65}.step-note{font-size:19rpx;line-height:1.7;color:#a48f6d;margin-top:4rpx}.step-connector{height:1rpx;background:#dfceb0;flex:0 0 22rpx}.learning-page .person-card .person-actions{margin:0 35rpx;padding:22rpx 0 27rpx;display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #e8dbc3;gap:12rpx}.learning-page .person-actions .card-reading-link{min-width:0;min-height:60rpx;padding:6rpx 0;background:transparent;border:0;color:#92744c;font-size:22rpx;flex:0 0 auto}.card-reading-link::after{border:0}.learning-next-actions{display:flex;align-items:center;gap:10rpx;margin-left:auto}.learning-page .learning-next-actions button{flex:none;min-width:165rpx;font-size:23rpx;min-height:70rpx;padding:14rpx 20rpx}.learning-page .learning-next-actions .secondary{min-width:0;font-size:20rpx;padding:8rpx;background:transparent;border:0}

