<view class="page">
  <view wx:if="{{loading}}" class="aux">正在读取关卡。</view>
  <view wx:elif="{{error}}" class="state">
    <view class="section">请求失败</view>
    <view class="aux">{{error}}</view>
    <button class="primary" bindtap="load">重新读取</button>
  </view>
  <block wx:else>
    <view class="eyebrow">待核验</view>
    <view class="title">学习挑战</view>
    <view class="aux">先答完入门关，再开始本组进阶关。入门关抽 5 题，进阶关抽 8 题。题目仍是待核验。</view>
    <button wx:if="{{continueId}}" class="secondary" bindtap="resume">继续上次答题</button>
    <view class="card">
      <view class="section">挑战进度</view>
      <view class="progress-split">
        <view>
          <view class="aux">入门</view>
          <view class="honor-stat">{{beginnerDone}} / {{total}} <text class="aux">已完成</text></view>
          <view class="meter"><view style="width: {{beginnerPercent}}%;"></view></view>
        </view>
        <view>
          <view class="aux">进阶</view>
          <view class="honor-stat">{{advancedDone}} / {{total}} <text class="aux">已完成</text></view>
          <view class="meter"><view style="width: {{advancedPercent}}%;"></view></view>
        </view>
      </view>
    </view>
    <view class="section-head"><text>角色挑战</text></view>
    <view class="filters">
      <view class="seg {{filter === 'all' ? 'on' : ''}}" data-filter="all" bindtap="setFilter">全部</view>
      <view class="seg {{filter === 'open' ? 'on' : ''}}" data-filter="open" bindtap="setFilter">待挑战</view>
      <view class="seg {{filter === 'done' ? 'on' : ''}}" data-filter="done" bindtap="setFilter">已完成</view>
    </view>
    <view wx:if="{{!visible.length}}" class="aux">这一栏还没有关卡。</view>
    <view class="card person-card" wx:for="{{visible}}" wx:key="name">
      <view class="person-main">
        <view class="mark">{{item.mark}}</view>
        <view class="copy">
          <view class="section">{{item.name}}</view>
          <view class="aux">{{item.archive}}</view>
        </view>
      </view>
      <text class="pill {{item.earned ? 'earned' : ''}}">{{item.status}}</text>
      <view class="person-actions">
        <button wx:if="{{item.primaryId}}" class="primary" data-id="{{item.primaryId}}" bindtap="begin">{{item.primaryLabel}}</button>
        <button wx:if="{{item.reviewId}}" class="secondary" data-id="{{item.reviewId}}" bindtap="begin">{{item.reviewLabel}}</button>
        <button wx:if="{{item.reviewAdvancedId}}" class="secondary" data-id="{{item.reviewAdvancedId}}" bindtap="begin">复习进阶</button>
      </view>
    </view>
    <button class="secondary" bindtap="openHonors">查看学习称号</button>
  </block>
</view>
<tab-bar current="learn"></tab-bar>
