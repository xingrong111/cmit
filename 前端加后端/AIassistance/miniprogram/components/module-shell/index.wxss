.brand{display:flex;align-items:center;padding:22rpx 32rpx 18rpx;border-bottom:1rpx solid #cbb38a;background:#fbf5e9;color:#35281d}.seal{background:#982b28;color:#fff6e6;font:25rpx/1.15 KaiTi,serif;padding:8rpx 9rpx;border-radius:3rpx}.seal text{display:block}.brand-copy{flex:1;margin-left:18rpx}.brand-title{font:38rpx/1.35 KaiTi,STKaiti,serif;letter-spacing:4rpx}.tagline{font:21rpx/1.7 sans-serif;color:#75604b}.menu{background:transparent;color:#982b28;border:0;padding:10rpx;margin:0;font-size:36rpx;line-height:1}.menu::after,.nav-item::after{border:0}.bottom-nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fffaf1;border-top:1rpx solid #cbb38a;padding:14rpx 10rpx calc(14rpx + env(safe-area-inset-bottom));z-index:20}.nav-item{flex:1;background:transparent;border:0;padding:0;margin:0;font-size:21rpx;color:#8a8276;line-height:1.6;border-radius:0}.selected{color:#9f2626}.nav-icon{margin:0 auto 4rpx;border:2rpx solid currentColor;border-radius:8rpx;width:36rpx;height:36rpx;font:26rpx/34rpx KaiTi,serif}
