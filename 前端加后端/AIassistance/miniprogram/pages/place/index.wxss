.venue-photo{background:#fffaf1;border:1rpx solid #ddd0b8;margin:24rpx 0;overflow:hidden;border-radius:12rpx}.venue-photo-image{display:block;width:100%}.venue-photo-credit{padding:24rpx;font-size:24rpx;line-height:1.8;color:#75604b}.venue-photo-credit .row{gap:12rpx}.venue-photo-credit button{font-size:22rpx}.venue-service-row{padding:26rpx 0;border-bottom:1rpx solid #ddd0b8;font-size:26rpx;line-height:1.85}.service-heading{font-family:SimSun,serif;color:#354d43;font-size:30rpx}.service-tag{font-size:20rpx;color:#75604b;padding:4rpx 10rpx;background:#354d430a;border:1rpx solid #ddd0b8;flex-shrink:0}.venue-service-row .row{flex-wrap:wrap;gap:12rpx}.venue-service-row button{font-size:24rpx}.venue-contact{background:#f1e7d566;padding:24rpx;border:1rpx solid #ddd0b8;margin-top:26rpx;font-size:26rpx}.venue-contact .row{display:flex;gap:12rpx}.venue-contact button{font-size:24rpx;flex:1}.venue-service .fold-title{padding-top:26rpx;border-top:1rpx solid #ddd0b8}
