# Local development only. Use HTTPS reverse proxy and PUBLIC_MODE=true when publishing.
HOST=127.0.0.1
PORT=3100
PUBLIC_MODE=false
# DeepSeek Chat Completions; no key means source retrieval still works.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
# Tencent Location Service WebService key; walking routes require this.
TENCENT_MAP_KEY=
# Dedicated browser-only key and optional Tencent custom-map style ID.
TENCENT_MAP_BROWSER_KEY=
TENCENT_MAP_STYLE_ID=
# Never set keys in miniprogram or preview files.
