page{--paper:#FFF9EC;--card:#FFFCF5;--red:#9C3029;--gold:#C7A166;--ink:#35291F;--muted:#75634D;--line:#E4D4B8;--success:#2F724F;background:var(--paper);color:var(--ink);font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.7}view,text,button,input,textarea{box-sizing:border-box}button{padding:0;margin:0;border:0;background:transparent;color:inherit;font:inherit;text-align:left}button:after{border:0}.page{padding:32rpx 32rpx 56rpx}.hero{padding:40rpx 32rpx;border:1rpx solid var(--gold);border-radius:20rpx;background:linear-gradient(135deg,#FFF8E7,#F3E1BE);overflow:hidden}.eyebrow{display:block;font-size:22rpx;letter-spacing:4rpx;color:#89653E}.title,.section-title{display:block;font-family:STKaiti,KaiTi,serif}.title{font-size:48rpx;line-height:1.35;color:var(--red);margin:12rpx 0}.section-title{font-size:36rpx;line-height:1.4}.muted,.small{display:block;color:var(--muted);font-size:24rpx;line-height:1.8}.small{font-size:22rpx}.card{background:var(--card);border:1rpx solid var(--line);border-radius:20rpx;padding:28rpx 24rpx;margin-top:24rpx;box-shadow:0 8rpx 22rpx rgba(80,57,29,.07)}.field{display:block;margin-top:24rpx;font-weight:600;font-size:28rpx}.field input,.field textarea{width:100%;margin-top:12rpx;padding:22rpx 20rpx;min-height:88rpx;background:#FFFDF8;border:1rpx solid #D4BF9E;border-radius:12rpx;font-size:28rpx;font-weight:400}.field textarea{height:230rpx}.primary,.secondary,.danger{min-height:88rpx;padding:0 24rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;text-align:center;font-weight:600}.primary{color:#FFF9EC;background:var(--red)}.secondary{color:var(--red);border:1rpx solid var(--gold);background:var(--card)}.danger{color:var(--red);border:1rpx solid #D9A99B;background:#F9E8E3}.full{width:100%;margin-top:28rpx}.row{display:flex;gap:16rpx;margin-top:24rpx}.row button{flex:1}.notice{padding:20rpx;border-left:6rpx solid var(--gold);border-radius:10rpx;background:#FBF3E2;color:#67513A;font-size:24rpx;line-height:1.7;margin-top:22rpx}.notice.error{border-left-color:var(--red);background:#F9E8E3;color:#7D322C}.notice.success{border-left-color:var(--success);background:#E8F2E9;color:#285D40}.status{display:inline-flex;padding:5rpx 14rpx;border-radius:99rpx;border:1rpx solid var(--line);font-size:22rpx;color:var(--muted)}.pending{background:#FBF2DD;color:#8A642D;border-color:#D9B96F}.approved,.published{background:#E8F2E9;color:var(--success);border-color:#A8C9AE}.rejected{background:#F9E8E3;color:var(--red);border-color:#DFB5AB}.item{padding:24rpx 0;border-bottom:1rpx solid var(--line)}.item:last-child{border-bottom:0}.item-head{display:flex;justify-content:space-between;gap:18rpx;align-items:flex-start}.comment{display:block;margin:14rpx 0;font-size:28rpx;line-height:1.75;word-break:break-all}.topic{display:block;margin-top:8rpx;color:var(--red);font-size:24rpx}.empty{padding:58rpx 20rpx;text-align:center;color:var(--muted)}.empty .section-title{font-size:34rpx;color:var(--ink);margin-bottom:12rpx}.menu{margin-top:24rpx}.menu button{width:100%;min-height:108rpx;border-bottom:1rpx solid var(--line);display:flex;align-items:center;justify-content:space-between}.menu text:first-child{font-family:STKaiti,KaiTi,serif;font-size:32rpx}.menu text:last-child{color:var(--red)}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.metric{padding:28rpx 24rpx;background:var(--card);border:1rpx solid var(--line);border-radius:16rpx}.metric text:first-child{display:block;color:var(--red);font-family:STKaiti,KaiTi,serif;font-size:58rpx;line-height:1}.metric text:last-child{display:block;color:var(--muted);font-size:22rpx;margin-top:12rpx}.tabs{display:flex;gap:12rpx;margin:24rpx 0}.tab{flex:1;min-height:72rpx;border:1rpx solid var(--line);border-radius:10rpx;background:#F7EDDB;color:var(--muted);display:flex;align-items:center;justify-content:center;text-align:center;font-size:24rpx}.tab.active{background:var(--red);color:#FFF9EC;border-color:var(--red)}
