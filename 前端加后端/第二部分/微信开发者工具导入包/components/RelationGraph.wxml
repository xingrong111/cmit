<view class="relation-graph data-v-d28780ce"><view class="graph-heading data-v-d28780ce"><view class="data-v-d28780ce"><text class="graph-eyebrow data-v-d28780ce">RELATION ATLAS</text><text class="graph-title data-v-d28780ce">人物与时代的交汇</text></view><text class="graph-count data-v-d28780ce">{{a}} 个节点 · {{b}} 条联系</text></view><view class="graph-filters data-v-d28780ce"><button wx:for="{{c}}" wx:for-item="item" wx:key="b" class="{{['filter-button', 'data-v-d28780ce', item.c && 'selected']}}" bindtap="{{item.d}}">{{item.a}}</button></view><view class="graph-viewport data-v-d28780ce" id="{{h}}" bindtouchstart="{{i}}" catchtouchmove="{{j}}" bindtouchend="{{k}}" bindtouchcancel="{{l}}" bindmousedown="{{m}}" bindmousemove="{{n}}" bindmouseup="{{o}}" bindmouseleave="{{p}}"><view class="graph-grid data-v-d28780ce"/><view class="graph-stage data-v-d28780ce" style="{{f}}"><view wx:for="{{d}}" wx:for-item="edge" wx:key="b" class="graph-edge data-v-d28780ce" style="{{edge.c}}" catchtap="{{edge.d}}"><view class="edge-stroke data-v-d28780ce"/><text class="edge-label data-v-d28780ce">{{edge.a}}</text></view><view wx:for="{{e}}" wx:for-item="node" wx:key="c" class="{{['graph-node', 'data-v-d28780ce', node.d]}}" style="{{node.e}}" catchtap="{{node.f}}"><text class="node-kind data-v-d28780ce">{{node.a}}</text><text class="node-name data-v-d28780ce">{{node.b}}</text></view></view><view wx:if="{{g}}" class="graph-empty data-v-d28780ce">暂无这一类关系记录</view><view class="graph-legend data-v-d28780ce"><text class="legend-person data-v-d28780ce">● 人物</text><text class="legend-event data-v-d28780ce">● 事件</text><text class="legend-group data-v-d28780ce">● 组织</text></view></view><view class="graph-controls data-v-d28780ce"><text class="graph-hint data-v-d28780ce">拖动探索 · 点节点查看 · 点连线读来源</text><view class="zoom-controls data-v-d28780ce"><button class="zoom-button data-v-d28780ce" aria-label="缩小关系图" bindtap="{{q}}">−</button><text class="zoom-value data-v-d28780ce">{{r}}%</text><button class="zoom-button data-v-d28780ce" aria-label="放大关系图" bindtap="{{s}}">+</button><button class="reset-button data-v-d28780ce" bindtap="{{t}}">复位</button></view></view><view class="relation-list data-v-d28780ce"><view class="list-heading data-v-d28780ce"><text class="data-v-d28780ce">联系索引</text><text class="list-caption data-v-d28780ce">以有出处的记录连接人物与事件</text></view><view wx:if="{{v}}" class="list-empty data-v-d28780ce">此筛选下没有已收录的联系。可切换“全部”查看。</view><view wx:for="{{w}}" wx:for-item="edge" wx:key="h" class="relation-row data-v-d28780ce"><view class="relation-description data-v-d28780ce"><text class="relation-name data-v-d28780ce" bindtap="{{edge.b}}">{{edge.a}}</text><text class="relation-type data-v-d28780ce">{{edge.c}}</text><text class="relation-name data-v-d28780ce" bindtap="{{edge.e}}">{{edge.d}}</text></view><button wx:if="{{edge.f}}" class="source-button data-v-d28780ce" bindtap="{{edge.g}}">查看出处 ↗</button><text wx:else class="source-missing data-v-d28780ce">来源待补</text></view></view></view>