<view class="{{__globalLarge ? 'global-large' : ''}}">
<view class="page {{motionOff ? 'motion-off' : ''}} safe-bottom radar-page">
 <button wx:if="{{archiveOnly}}" class="ghost" bindtap="clearArchive">查看全部场馆</button><view class="hero"><button class="motion-toggle" bindtap="toggleMotion">{{motionOff ? '开启动效' : '暂停动效'}}</button><view class="eyebrow">让历史与此刻相遇</view><view class="module-title-row"><image class="module-feature-icon" src="/static/icons/pin.png"/><view class="title">历史足迹雷达</view></view><view class="subtitle">附近有什么 · 怎么去 · 到了看什么</view></view>
 
 <view class="row wrap"><text class="label">{{locationLabel}}</text><text class="fine">{{label}}</text></view>
 <view class="row gap"><button class="primary" bindtap="locate" disabled="{{busy}}">使用当前位置</button><picker range="{{cities}}" bindchange="city"><button class="ghost">选择城市 ›</button></picker></view>
 <view class="chips"><button class="chip {{!type ? 'active' : ''}}" data-type="" bindtap="filter">全部</button><button class="chip {{type === '纪念馆' ? 'active' : ''}}" data-type="纪念馆" bindtap="filter">纪念馆</button><button class="chip {{type === '故居' ? 'active' : ''}}" data-type="故居" bindtap="filter">故居</button><picker range="{{ranges}}" value="{{rangeIndex}}" bindchange="range"><button class="chip">{{ranges[rangeIndex]}}范围</button></picker></view>
 <view class="row"><input class="input" value="{{q}}" bindinput="input" bindconfirm="search" placeholder="搜索场所或地址"/><button class="ghost" bindtap="search">搜索</button></view>
 <view class="row gap"><text class="heading">{{city}} · 历史地点</text><view class="chips"><button class="chip {{viewMode === 'map' ? 'active' : ''}}" data-view="map" bindtap="view">地图</button><button class="chip {{viewMode === 'list' ? 'active' : ''}}" data-view="list" bindtap="view">列表</button></view></view>
 <view wx:if="hasMap &amp;&amp; viewMode === 'map'" class="native-ink-map"><view class="native-map-heading"><view><view class="fine">山河有迹 / CITY EXPLORER</view><view class="heading">{{city}} · 历史足迹</view></view><text class="native-map-seal">迹</text></view> <map  class="map gap" latitude="{{latitude}}" longitude="{{longitude}}" markers="{{markers}}" include-points="{{includePoints}}" show-location="{{hasPosition}}" bindmarkertap="marker" bindcallouttap="marker"/>
<view class="native-map-caption">朱红编号为场馆候选点，可拖动缩放；不代表已核验游客入口。</view></view>
 <view wx:elif="viewMode === 'map'" class="theme-map-card gap"><view class="map-heading">{{city}} · 足迹地图<text class="map-kind">城市意象</text></view><view class="theme-map-viewport"><view class="theme-map-layer" style="transform:scale({{mapZoom}})"><image class="theme-map-art" src="/assets/map-city.svg" mode="scaleToFill"/><view wx:for="{{items}}" wx:key="id" wx:if="index &lt; 4" class="map-pin {{selectedId === item.id ? 'selected' : ''}}" style="left:{{mapPoints[index].left}}%;top:{{mapPoints[index].top}}%" data-id="{{item.id}}" bindtap="select"><view class="pin-number">{{index + 1}}</view><view class="pin-name">{{item.name}}</view></view></view><view class="map-tools"><button data-zoom="in" bindtap="zoomMap">＋</button><button data-zoom="out" bindtap="zoomMap">−</button><button data-zoom="reset" bindtap="zoomMap">复位</button></view><text class="map-watermark">山河有迹</text></view><view class="map-caption">点选标记浏览地点；标记排布为示意，不代表入口坐标。</view></view>
 <view wx:if="hasMap &amp;&amp; viewMode === 'map'" class="fine gap">候选点仅用于位置参考，不代表已核验游客入口。</view><view wx:if="selected &amp;&amp; viewMode === 'map'" class="place-mini map-selection"><view class="fine">当前选中 · {{selected.type}}</view><view class="heading">{{selected.name}}</view><view class="muted">{{selected.distanceLabel}}</view><button class="ghost gap" data-id="{{selected.id}}" bindtap="place">查看地点详情</button></view>
 <view class="hint" wx:if="error">{{error}}<button class="ghost gap" bindtap="load">重试查询</button><button class="ghost gap" bindtap="settings">检查小程序授权设置</button><button class="ghost gap" bindtap="browseCity">改用城市浏览</button></view>
 <view class="muted gap">{{notice}}</view>
 <view wx:if="busy" class="card"><view class="fine">正在查找场所……</view><view class="skeleton"></view><view class="skeleton short"></view></view><view wx:elif="!items.length" class="empty">当前没有匹配的已接入地点。<view class="muted">不表示当地没有历史场所，可以调整筛选或选择城市。</view></view>
 <button wx:if="{{viewMode==='map' &amp;&amp; items.length}}" class="ghost gap" bindtap="toggleList" aria-expanded="{{listExpanded}}">{{listExpanded?'收起':'展开'}}地点列表（{{items.length}}）</button><view wx:if="{{viewMode==='list' || listExpanded}}"><view wx:for="{{items}}" wx:key="id" class="card {{selectedId === item.id ? 'selected-place' : ''}}" data-id="{{item.id}}" bindtap="select"><view class="row"><view class="heading">{{item.name}}</view><text class="label">{{item.type}}</text></view><view class="muted gap">{{item.address}}</view><view class="gap">{{item.summary}}</view><view class="row gap"><text class="fine">{{item.distanceLabel}}</text><button class="ghost" data-id="{{item.id}}" catchtap="place">查看地点 ›</button></view></view>
 </view>
 <button class="primary gap" bindtap="route">我的文化路线</button>
</view>
</view>