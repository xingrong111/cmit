<app-shell u-s="{{['d']}}" u-i="66db0d2d-0" bind:__l="__l"><view class="detail-crumb"><button class="text-button" bindtap="{{a}}">‹ 返回名单</button><button class="text-button" bindtap="{{b}}">收录说明</button></view><block wx:if="{{c}}"><view class="registry-cover"><image src="{{d}}" mode="aspectFill"/><view><text class="eyebrow">人物资料条目 / RECORD</text><text class="page-title">{{e}}</text><text class="tag">本项目收录条目</text></view></view><view class="identity-grid"><view><text>出生日期</text><text>{{f}}</text></view><view><text>籍贯原文</text><text>{{g}}</text></view><view><text>出生地</text><text>{{h}}</text></view></view><view wx:if="{{i}}" class="fact-card"><text class="section-title">补充资料说明</text><text wx:if="{{j}}" class="reading-body">祖籍：{{k}}（与本人籍贯分别记录）</text><text wx:if="{{l}}" class="tag">出生日期有另载 · 尚未定论</text><text wx:if="{{m}}" class="reading-body">{{n}}</text><text wx:for="{{o}}" wx:for-item="note" wx:key="b" class="small">{{note.a}}</text><text wx:if="{{p}}" class="small" selectable>出生日期补充来源：{{q}}</text><text wx:for="{{r}}" wx:for-item="u" wx:key="b" class="small" selectable>回填来源线索：{{u.a}}</text></view><view wx:if="{{s}}" class="fact-card"><text class="section-title">地域补充资料</text><text wx:if="{{t}}" class="reading-body">{{v}}</text><view wx:for="{{w}}" wx:for-item="e" wx:key="i"><text class="small">{{e.a}} · {{e.b}}</text><text wx:if="{{e.c}}" class="reading-body">{{e.d}}</text><text wx:if="{{e.e}}" class="small">{{e.f}}</text><text wx:if="{{e.g}}" class="small" selectable>{{e.h}}</text></view></view><view class="fact-card"><text class="section-title">资料与依据</text><text wx:if="{{x}}" class="small" selectable>出生地来源：{{y}}</text><text class="small">来源类别：{{z}}</text><text class="small">地区依据：{{A}}</text><text wx:if="{{B}}" class="small">地域摘录：{{C}} · {{D}}</text><text class="reading-body">{{E}}</text><text class="small">{{F}}</text><text class="small">来源正文与字段含义请结合查看。</text><view wx:if="{{G}}" class="source-url"><text selectable>{{H}}</text><button class="outline" bindtap="{{I}}">复制来源