<view class="page learning-page">
  <view wx:if="{{loading}}" class="aux">正在读取称号。</view>
  <view wx:elif="{{error}}" class="state">
    <view class="section">请求失败</view>
    <view class="aux">{{error}}</view>
    <button class="primary" bindtap="load">重新读取</button>
  </view>
  <block wx:else>
    <view class="eyebrow">待核验</view>
    <view class="title">学习称号</view>
    <view class="card">
      <view class="honor-profile">
        <view class="mark">谱</view>
        <view>
          <view class="section">山河英雄谱</view>
          <view class="aux">学习挑战 · 待核验</view>
        </view>
        <view class="ribbon">待核验</view>
      </view>
      <view class="honor-stats">
        <view>
          <view class="aux">当前称号</view>
          <view class="honor-stat">{{current}}</view>
        </view>
        <view>
          <view class="aux">已获得称号</view>
          <view class="honor-stat">{{earnedCount}} / {{totalCount}}</view>
        </view>
        <view>
          <view class="aux">收集进度</view>
          <view class="honor-stat">{{percent}}%</view>
          <view class="meter"><view style="width: {{percent}}%;"></view></view>
        </view>
      </view>
      <view class="aux">{{note}} 已读完 {{completed}} / 5 组。</view>
    </view>
    <view class="filters">
      <view class="seg {{filter === 'all' ? 'on' : ''}}" data-filter="all" bindtap="setFilter">全部</view>
      <view class="seg {{filter === 'group' ? 'on' : ''}}" data-filter="group" bindtap="setFilter">单组</view>
      <view class="seg {{filter === 'cross' ? 'on' : ''}}" data-filter="cross" bindtap="setFilter">跨组</view>
    </view>
    <block wx:if="{{filter !== 'cross'}}">
      <view class="section-head" bindtap="toggleGroup">
        <text>单组称号</text>
        <text class="aux">共 {{groupItems.length}} 个 · {{groupOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{groupOpen}}">
        <view class="honor-card" wx:for="{{groupItems}}" wx:key="key">
          <view class="mark">{{item.mark}}</view>
          <view class="copy">
            <view class="section">{{item.name}}</view>
            <view class="aux">{{item.detail}}</view>
          </view>
          <text class="pill {{item.earned ? 'earned' : ''}}">{{item.state}}</text>
        </view>
      </block>
    </block>
    <block wx:if="{{filter !== 'group'}}">
      <view class="section-head" bindtap="toggleCross">
        <text>跨组称号</text>
        <text class="aux">共 {{crossItems.length}} 个 · {{crossOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{crossOpen}}">
        <view class="honor-card" wx:for="{{crossItems}}" wx:key="key">
          <view class="mark">{{item.mark}}</view>
          <view class="copy">
            <view class="section">{{item.name}}</view>
            <view class="aux">{{item.detail}}</view>
          </view>
          <text class="honor-progress">{{item.progress}}</text>
          <text class="pill {{item.earned ? 'earned' : ''}}">{{item.state}}</text>
        </view>
      </block>
    </block>
    <button class="primary" bindtap="hall">返回学习挑战</button>
  </block>
</view>

