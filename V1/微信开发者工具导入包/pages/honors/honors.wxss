.honor-profile { display: flex; align-items: center; gap: 16rpx; }
.mark { width: 72rpx; height: 72rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 1rpx solid #C7A166; border-radius: 50%; background: #FFF9EC; color: #9C3029; font-family: "STKaiti", "KaiTi", "SimSun", serif; font-size: 32rpx; }
.ribbon { margin-left: auto; writing-mode: vertical-rl; letter-spacing: 4rpx; border: 1rpx solid #C7A166; color: #9C3029; font-family: "STKaiti", "KaiTi", "SimSun", serif; font-size: 24rpx; line-height: 1.4; padding: 12rpx 8rpx; background: #FFF9EC; }
.honor-stats { display: flex; margin-top: 24rpx; padding-top: 16rpx; border-top: 1rpx solid #E4D4B8; }
.honor-stats > view { flex: 1; }
.honor-stats > view + view { border-left: 1rpx solid #E4D4B8; padding-left: 16rpx; }
.honor-stat { font-family: "STKaiti", "KaiTi", "SimSun", serif; font-size: 32rpx; line-height: 1.35; }
.meter { height: 8rpx; margin-top: 8rpx; background: #E4D4B8; border-radius: 8rpx; overflow: hidden; }
.meter view { height: 8rpx; background: #9C3029; }
.filters { display: flex; gap: 16rpx; margin-top: 24rpx; }
.seg { flex: 1; min-height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 40rpx; border: 1rpx solid #E4D4B8; background: #FFFCF5; color: #35291F; font-size: 28rpx; }
.seg.on { background: #9C3029; color: #FFF9EC; border-color: #9C3029; }
.section-head { display: flex; justify-content: space-between; align-items: center; min-height: 88rpx; margin-top: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #E4D4B8; font-family: "STKaiti", "KaiTi", "SimSun", serif; font-size: 32rpx; }
.honor-card { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; padding: 24rpx; background: #FFFCF5; border: 1rpx solid #C7A166; border-radius: 20rpx; box-shadow: 0 8rpx 22rpx rgba(79, 57, 29, .08); }
.copy { flex: 1; min-width: 0; }
.honor-progress { flex: none; color: #75634D; font-size: 24rpx; }
.pill { flex: none; border: 1rpx solid #C7A166; border-radius: 40rpx; color: #75634D; font-size: 24rpx; line-height: 1.6; padding: 4rpx 16rpx; }
.pill.earned { color: #2F724F; border-color: #2F724F; }
.honor-path-summary{padding:40rpx;background:linear-gradient(115deg,#eee7d3,#fffaf1);border-radius:28rpx}.honor-path-summary .section{font:50rpx/1.6 STSong,SimSun,serif;color:#354d43;margin:13rpx 0}.honor-path-summary .aux{font-size:24rpx;line-height:1.9}.honor-growth-item{display:flex;align-items:center;gap:22rpx;padding:32rpx 28rpx;margin:22rpx 0;border:1rpx solid #e2d4bb;border-radius:25rpx;background:#fffaf2}.honor-step-number{display:flex;align-items:center;justify-content:center;flex:0 0 65rpx;width:65rpx;height:76rpx;border:1rpx solid #d9c4a0;border-radius:10rpx 10rpx 24rpx 10rpx;background:#eee4ce;color:#a08456;font:37rpx/1 Georgia,serif}.honor-growth-item .copy{flex:1;min-width:0}.honor-growth-item .eyebrow{font-size:18rpx;color:#a38a60}.honor-growth-item .section{font:38rpx/1.6 STSong,SimSun,serif;color:#354d43;margin:8rpx 0}.honor-growth-item .aux{font-size:22rpx;line-height:1.8}.honor-growth-status{font-size:21rpx;color:#9e8b6d;line-height:1.9;text-align:right}.honor-growth-item.earned .honor-step-number{background:#354d43;color:#fffaf1}.honor-growth-item.next{border-color:#bd9a67;background:#faf2e2;border-left:6rpx solid #982b28}.honor-growth-item.next .honor-growth-status{color:#982b28}.honor-rule-note{font-size:22rpx;color:#9e8a69;background:#f1e9da;line-height:1.9;padding:25rpx;border-radius:17rpx;margin:30rpx 0}
.badge-album-cover{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:35rpx;background:linear-gradient(115deg,#ede4cf,#fffaf2);border-radius:28rpx}.badge-album-cover>view{flex:1}.badge-album-cover .section{font:44rpx/1.7 STSong,SimSun,serif;color:#354d43;margin:10rpx 0}.badge-album-cover .aux{font-size:23rpx}.album-current-badge{width:180rpx;height:180rpx;flex-shrink:0}.unearned{opacity:.6;filter:grayscale(.85)}.next-goal{font-size:23rpx;line-height:1.8;padding:10rpx 0 22rpx;color:#a0865c}.badge-album-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:19rpx}.badge-album-card{text-align:center;padding:25rpx 19rpx;border:1rpx solid #e2d3ba;border-radius:25rpx;background:#fffaf2}.badge-album-card>image{width:210rpx;height:210rpx;margin:18rpx auto 8rpx;display:block}.badge-album-card .eyebrow{font-size:18rpx;color:#a58c65;text-align:left}.badge-album-card .section{font:35rpx/1.6 STSong,SimSun,serif;color:#354d43;margin:10rpx 0}.badge-album-card .aux{font-size:21rpx;line-height:1.9;margin-top:16rpx;color:#9d8765}.badge-state{display:inline-block;padding:6rpx 18rpx;border-radius:22rpx;background:#eee6d6;color:#9b815a;font-size:20rpx}.badge-album-card.earned .badge-state{background:#e5eddc;color:#466044}.badge-album-card.next{border-color:#bd9a67;background:#fbf2df;border-top:5rpx solid #982b28}.badge-album-card.locked>image{filter:grayscale(1);opacity:.45}.badge-album-card.next>image{opacity:.82}

@import "../../统一视觉.wxss";
