<view class="{{__globalLarge ? 'global-large' : ''}}"><view class="explicit-return"><button bindtap="__returnPrevious">‹ 返回上一页</button></view>

<view class="page safe-bottom"><view class="hero"><view class="eyebrow">每项记载 · 有迹可循</view><view class="title">资料来源</view><view class="subtitle">网页记载与历史原件分开核验</view></view><view wx:for="{{items}}" wx:key="id" class="card"><view class="heading">{{item.title}}</view><view class="muted gap">{{item.institution}}</view><view class="fine">发布：{{item.publishedAt}} · 访问：{{item.accessedAt}}</view><view class="gap">证据位置：{{item.position}}</view><view class="gap">必要短摘录：{{item.excerpt}}</view><view class="muted gap">{{item.relation}}</view><view class="fine gap">{{item.accessStatus || '来源已有记录，仍需独立核对'}}。访问日期不是独立复核通过日期。</view><view class="url gap">原始地址：{{item.url}}</view><view class="url gap">最终地址：{{item.finalUrl || item.url}}</view><button class="ghost gap" data-url="{{item.url}}" bindtap="copy">复制原始来源链接</button><button wx:if="{{item.finalUrl && item.finalUrl !== item.url}}" class="ghost gap" data-url="{{item.finalUrl}}" bindtap="copy">复制跳转后的最终地址</button></view><view wx:if="!items.length" class="empty">当前没有来源条目。</view></view>
</view>