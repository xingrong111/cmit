<view class="{{__globalLarge ? 'global-large' : ''}}"><view class="explicit-return"><button bindtap="__returnPrevious">‹ 返回上一页</button></view>
<view class="page"><view class="hero"><text class="eyebrow">人物档案 / DISCUSSION</text><text class="title">{{topic.title}}</text><text class="muted">公开区仅展示已审核评论。请交流阅读感受，或提供可核验的资料线索。</text></view><view wx:if="{{user}}" class="card"><text class="section-title">写下学习感受</text><label class="field">评论内容<textarea value="{{content}}" maxlength="500" bindinput="input" placeholder="2—500个字符；提交后进入待审核。" /></label><button class="primary full" bindtap="submit">提交审核</button><text class="small">审核通过前，仅作者与管理员可见。</text></view><view wx:else class="card"><text class="section-title">登录后参与讨论</text><text class="muted">阅读无需登录；提交评论需账户。</text><button class="primary full" bindtap="login">去登录</button></view><view class="card"><view class="item-head"><text class="section-title">已公开讨论</text><text class="status approved">审核通过</text></view><view wx:if="{{loading}}" class="empty">加载中…</view><view wx:elif="{{!items.length}}" class="empty"><text class="section-title">暂无已公开讨论</text><text>第一条评论经审核后会显示在这里。</text></view><view wx:else><view wx:for="{{items}}" wx:key="id" class="item"><view class="item-head"><text>{{item.author.nickname}}</text><text class="status approved">已公开</text></view><text class="comment">{{item.content}}</text><text class="small">{{item.updatedAt}}</text></view></view></view></view>
</view>