<module-shell active="radar"/>
<view class="page {{motionOff ? 'motion-off' : ''}} detail-page"><view wx:if="busy" class="card"><view class="fine">正在读取地点……</view><view class="skeleton"></view><view class="skeleton short"></view></view><view wx:if="error" class="hint">{{error}}<button class="ghost gap" bindtap="load">重新加载</button></view>
<block wx:if="place"><view class="hero"><button class="motion-toggle" bindtap="toggleMotion">{{motionOff ? '开启动效' : '暂停动效'}}</button><view class="eyebrow">{{place.city}} · {{place.type}}</view><view class="title">{{place.name}}</view><view class="fine">{{place.contentLabel}}</view></view><view wx:if="{{place.photo}}" class="venue-photo"><image class="venue-photo-image" src="{{place.photo.displayURL}}" mode="aspectFill" bindtap="previewPhoto" binderror="photoError"/><view wx:if="{{photoFailed}}" class="fine">资料照片暂未加载，可查看原始来源。</view><view class="venue-photo-credit"><view>{{place.photo.caption}}</view><view class="fine gap">{{place.photo.credit}}</view><view class="fine">{{place.photo.changes}}</view><view class="row gap"><button class="ghost" bindtap="photoSource">复制原图来源</button><button wx:if="{{place.photo.licenseURL}}" class="ghost" bindtap="photoLicense">复制许可链接</button></view></view></view><view wx:else class="scene-illustration"><text>山河主题装饰 · 非建筑实景复原</text></view>
<view class="card story-card"><view class="eyebrow">人物与场所</view><view class="heading">在这里，读懂一段历史</view><view class="gap">{{place.summary}}</view><view class="fine gap">{{place.historicalScope}}</view></view>
<view class="card focus-card"><view class="heading">到这里看什么</view><view wx:for="{{place.visitFocus}}" wx:key="*this" class="focus gap"><text class="focus-number">0{{index + 1}}</text><view class="focus-copy">{{item}}</view></view></view>
<view class="card venue-service"><view class="eyebrow">参观准备</view><view class="heading">出发前了解</view><view class="gap">{{place.address}}</view><button class="ghost gap" bindtap="copyAddress">复制场馆地址</button><view class="hint">{{place.visitorService.currentNotice}}</view><block wx:for="{{place.visitorService.entries}}" wx:key="key"><view wx:if="{{item.status!=='unknown' &amp;&amp; item.sourceIds.length}}" class="venue-service-row"><view class="row"><text class="service-heading">{{item.label}}</text><text class="service-tag">{{item.statusLabel}}</text></view><view class="gap">{{item.text}}</view><view class="fine gap" wx:if="{{item.sourceIds.length}}">原记录：{{item.recordDate}}</view><button wx:if="{{item.sourceIds.length}}" class="ghost gap" data-key="{{item.key}}" bindtap="serviceSource">查看本项依据</button></view></block><view wx:for="{{place.visitorService.contacts}}" wx:key="number" class="venue-contact"><view>{{item.label}}</view><view class="gap">{{item.number}}</view><view class="fine">原记录：{{item.recordDate}} · 当前是否接通需确认</view><view class="row gap"><button class="primary" data-index="{{index}}" bindtap="callContact">拨打咨询电话</button><button class="ghost" data-index="{{index}}" bindtap="copyContact">复制电话</button></view><button class="ghost gap" data-index="{{index}}" bindtap="contactSource">查看电话依据</button></view><view wx:if="{{!place.visitorService.contacts.length}}" class="fine gap">尚未核到场馆咨询电话，不采用页脚技术电话或地图平台电话。</view><view class="fine gap">{{place.routeReady ? '导航可导航至场馆附近，实际入口以现场指引为准' : '场馆点位待确认，暂不提供导航'}}</view><button class="ghost gap" disabled="{{!place.routeReady}}" bindtap="navigate">导航至场馆附近</button><view class="fold-title gap" bindtap="toggleChecklist"><text class="heading">出发前核对清单</text><text>{{checklistOpen ? '收起 −' : '展开 ＋'}}</text></view><view wx:if="{{checklistOpen}}"><view wx:for="{{place.visitorService.checklist}}" wx:key="*this" class="fine gap">{{index + 1}}. {{item}}</view></view></view>
<view wx:if="{{place.candidateMapReady}}" class="card"><view class="eyebrow">地图位置参考</view><view class="heading">已接入地图候选点</view><view class="gap">{{place.mapCandidate.name}}</view><view class="fine gap">平台地址：{{place.mapCandidate.address}}</view><view class="fine gap">{{place.mapCandidate.comparisonNote}}</view><view class="fine gap">GCJ-02：{{place.mapCandidate.coordinate.latitude}}, {{place.mapCandidate.coordinate.longitude}}</view><view class="fine" wx:if="{{place.mapCandidate.telephone}}">地图平台电话（未独立确认）：{{place.mapCandidate.telephone}}</view><view class="hint">已允许试读地图展示；可导航至场馆附近；实际游客入口以现场指引为准，开放与预约需另行确认。</view><button class="ghost gap" bindtap="copyPoi">复制候选坐标</button></view><view class="card" wx:if="place.relatedPeople.length"><view class="heading">关联人物</view><button wx:for="{{place.relatedPeople}}" wx:key="id" class="ghost gap" data-id="{{item.id}}" bindtap="person">{{item.name}} · 查看人物档案 ›</button><view class="fine gap">人物档案由团队主工程接入</view></view>
<view class="card"><view class="fold-title" bindtap="toggleEvidence"><text class="heading">资料与图片说明</text><text>{{evidenceOpen ? '收起 −' : '展开 ＋'}}</text></view><block wx:if="evidenceOpen"><view class="fine gap">最近来源访问：{{place.evidenceInfo.lastSourceAccess}}</view><view class="fine">独立复核日期：{{place.evidenceInfo.independentReviewDate}}</view><view class="fine">{{place.evidenceInfo.reviewLabel}}</view><view class="fine">{{place.evidenceInfo.entranceLabel}}</view><view class="fine gap">{{place.evidenceInfo.imageLabel}}</view><view class="fine">图片许可、场馆身份和当前入口分别核对。正式照片须展示作者、来源、许可及修改说明。</view></block><button class="ghost gap" bindtap="source">查看原始资料与证据位置</button></view><button class="ghost gap" bindtap="route">查看我的文化路线</button>
</block></view><view wx:if="place" class="dock"><button class="ghost" bindtap="assistant">问导览助手</button><button class="primary" disabled="{{added}}" bindtap="add">{{added ? '已加入路线' : '加入路线草案'}}</button></view>
